# ============================================================
# UAV Planner 本地配置（AI 评估接入）
# ============================================================
# 本文件已被 .gitignore 忽略，可以安全填写真实 API Key，不会提交到仓库。
# 首次使用：复制本模板为 .env（与 config.json 同级，即仓库根目录），再填入真实值。
#
#   Copy-Item .env.example .env
#
# 优先级：真实环境变量 > .env > config.json 的 ai 段 > config.py 默认值
# ============================================================

# ---- 是否启用 LLM 版报告 ----
# false = 只出规则模板版（离线、无需 Key、演示保底）
# true  = 调用下面配置的 OpenAI 兼容接口生成报告
UAV_AI_ENABLED=false

# ---- API URL（OpenAI 兼容网关的 base_url，不要带 /chat/completions）----
# 云端示例：UAV_AI_BASE_URL=https://api.openai.com/v1
# 本地 Ollama 示例：UAV_AI_BASE_URL=http://localhost:11434/v1
# vLLM 示例：UAV_AI_BASE_URL=http://localhost:8000/v1
UAV_AI_BASE_URL=

# ---- 模型名（由服务端决定可用值）----
# 云端示例：UAV_AI_MODEL=gpt-4o-mini
# 本地 Ollama 示例：UAV_AI_MODEL=qwen2.5:7b
UAV_AI_MODEL=

# ---- API Key ----
# 云端网关必填；本地 Ollama / LM Studio 可留空。
UAV_AI_API_KEY=

# ---- 生成参数（可选，留空则用 config.py 默认值）----
# 单次请求超时（秒），默认 60
UAV_AI_TIMEOUT_S=60
# 生成上限（token），默认 900。
# 六段中文报告实测需要 1200 以上，900 会让「时间窗口」报告在末段被截断；
# 若发现报告句子中途收尾，把这个值调到 1600 左右。
UAV_AI_MAX_TOKENS=900
# 推理型模型（MiniMax-M3 / DeepSeek-R1 / QwQ 等）的思考输出开关。
# disabled = 请求模型不要输出思考过程（推荐，默认值）；
# adaptive = 由模型自行决定是否思考（正文仍可能混入自言自语）；
# 留空 = 不发送该参数，供 Ollama / vLLM 等不认识它的网关使用。
UAV_AI_THINKING=disabled
# 是否在响应侧再兜底过滤一次思考内容（丢弃 reasoning 字段、剥离内联思考标签）。
# 默认 true；仅在确认网关输出绝对干净时才建议关掉。
UAV_AI_STRIP_THINKING=true