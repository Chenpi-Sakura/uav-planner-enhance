# Logs
# 统一落点是仓库根的 logs/（start.bat 自己走 %TEMP%，两处互不重叠）。
# 这里忽略整棵 logs/，手工排查的产物一律不要入库。
logs/
*.log
# 手工起进程留下的 PID 文件
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Data
data/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.env
venv/
.python/

# Frontend build/cache artifacts
.vite-cache/
.vite/
frontend/.tsbuildinfo/
*.tsbuildinfo

# 内网穿透隧道二进制与含 auth token 的配置，不入库
frp/

# 湍流定档探针的样本缓存（.npy，数百 MB），不入库
.tmp-*/
